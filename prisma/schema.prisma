generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum EstadoEstudiante {
  ACTIVO
  INACTIVO
  RETIRADO
}

enum EstadoDocente {
  ACTIVO
  INACTIVO
}

enum EstadoInscripcion {
  ACTIVA
  RETIRADA
}

enum EstadoPeriodo {
  PLANIFICADO
  ACTIVO
  CERRADO
}

enum EstadoCredencial {
  ACTIVA
  INACTIVA
  REVOCADA
}

enum EstadoAsistencia {
  PUNTUAL
  ATRASO
}

enum Jornada {
  MANANA
  TARDE
  NOCHE
}

model Usuario {
  id             String        @id @default(uuid()) @db.Uuid
  nombreUsuario  String        @unique @map("nombre_usuario") @db.VarChar(80)
  correo         String        @unique @db.VarChar(180)
  contrasenaHash String        @map("contrasena_hash") @db.VarChar(255)
  nombreCompleto String        @map("nombre_completo") @db.VarChar(180)
  estado         EstadoUsuario @default(ACTIVO)
  creadoEn       DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime      @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  creadoPor      String?       @map("creado_por") @db.Uuid
  actualizadoPor String?       @map("actualizado_por") @db.Uuid
  roles          UsuarioRol[]
  sesiones       Sesion[]
  asistencias    Asistencia[]  @relation("RegistradoPor")
  auditorias     Auditoria[]

  @@map("usuarios")
}

model Rol {
  id       String       @id @default(uuid()) @db.Uuid
  codigo   String       @unique @db.VarChar(50)
  nombre   String       @db.VarChar(100)
  usuarios UsuarioRol[]

  @@map("roles")
}

model UsuarioRol {
  usuarioId String  @map("usuario_id") @db.Uuid
  rolId     String  @map("rol_id") @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Restrict)

  @@id([usuarioId, rolId])
  @@index([rolId])
  @@map("usuarios_roles")
}

model PeriodoAcademico {
  id                     String                @id @default(uuid()) @db.Uuid
  nombre                 String                @db.VarChar(100)
  gestion                Int
  fechaInicio            DateTime              @map("fecha_inicio") @db.Date
  fechaFin               DateTime              @map("fecha_fin") @db.Date
  estado                 EstadoPeriodo         @default(PLANIFICADO)
  creadoEn               DateTime              @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn          DateTime              @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  inscripciones          Inscripcion[]
  configuracionHorario   ConfiguracionHorario?
  asignacionesAcademicas AsignacionAcademica[]

  @@index([estado])
  @@map("periodos_academicos")
}

model Curso {
  id                     String                @id @default(uuid()) @db.Uuid
  nombre                 String                @db.VarChar(100)
  nivel                  String                @db.VarChar(60)
  paralelo               String                @db.VarChar(10)
  gestion                Int
  activo                 Boolean               @default(true)
  creadoEn               DateTime              @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn          DateTime              @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  inscripciones          Inscripcion[]
  horarios               HorarioIngreso[]
  planillaHorario        CeldaHorarioCurso[]
  asistencias            Asistencia[]
  docentes               DocenteCurso[]
  horariosClase          HorarioClase[]
  asignacionesAcademicas AsignacionAcademica[]

  @@unique([nivel, paralelo, gestion])
  @@index([activo])
  @@map("cursos")
}

model ConfiguracionHorario {
  id                String           @id @default(uuid()) @db.Uuid
  periodoId         String           @unique @map("periodo_id") @db.Uuid
  horaInicio        DateTime         @map("hora_inicio") @db.Time(0)
  horaFin           DateTime         @map("hora_fin") @db.Time(0)
  intervaloMinutos  Int              @default(30) @map("intervalo_minutos")
  toleranciaMinutos Int              @default(5) @map("tolerancia_minutos")
  zonaHoraria       String           @default("America/La_Paz") @map("zona_horaria") @db.VarChar(80)
  version           Int              @default(1)
  creadoEn          DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime         @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  periodo           PeriodoAcademico @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  recreos           RecreoHorario[]
  horariosClase     HorarioClase[]

  @@map("configuraciones_horario")
}

model RecreoHorario {
  id              String               @id @default(uuid()) @db.Uuid
  configuracionId String               @map("configuracion_id") @db.Uuid
  nombre          String               @db.VarChar(80)
  horaInicio      DateTime             @map("hora_inicio") @db.Time(0)
  horaFin         DateTime             @map("hora_fin") @db.Time(0)
  activo          Boolean              @default(true)
  creadoEn        DateTime             @default(now()) @map("creado_en") @db.Timestamptz(3)
  configuracion   ConfiguracionHorario @relation(fields: [configuracionId], references: [id], onDelete: Cascade)

  @@index([configuracionId, activo, horaInicio])
  @@map("recreos_horario")
}

model Materia {
  id                     String                @id @default(uuid()) @db.Uuid
  codigo                 String                @unique @db.VarChar(30)
  nombre                 String                @unique @db.VarChar(120)
  activo                 Boolean               @default(true)
  creadoEn               DateTime              @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn          DateTime              @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  horariosClase          HorarioClase[]
  asignacionesAcademicas AsignacionAcademica[]

  @@index([activo, nombre])
  @@map("materias")
}

model Aula {
  id            String         @id @default(uuid()) @db.Uuid
  codigo        String         @unique @db.VarChar(30)
  nombre        String         @db.VarChar(120)
  capacidad     Int?
  ubicacion     String?        @db.VarChar(160)
  activo        Boolean        @default(true)
  creadoEn      DateTime       @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime       @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  horariosClase HorarioClase[]

  @@index([activo, nombre])
  @@map("aulas")
}

model CeldaHorarioCurso {
  cursoId   String   @map("curso_id") @db.Uuid
  diaSemana Int      @map("dia_semana")
  hora      Int
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  curso     Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@id([cursoId, diaSemana, hora])
  @@map("celdas_horario_curso")
}

model Estudiante {
  id               String           @id @default(uuid()) @db.Uuid
  codigoEstudiante Int              @unique @default(autoincrement()) @map("codigo_estudiante")
  numeroDocumento  String?          @unique @map("numero_documento") @db.VarChar(30)
  nombres          String           @db.VarChar(100)
  apellidos        String           @db.VarChar(120)
  fechaNacimiento  DateTime?        @map("fecha_nacimiento") @db.Date
  nombreTutor      String?          @map("nombre_tutor") @db.VarChar(180)
  telefonoTutor    String?          @map("telefono_tutor") @db.VarChar(30)
  fotografiaUrl    String?          @map("fotografia_url") @db.Text
  estado           EstadoEstudiante @default(ACTIVO)
  creadoEn         DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime         @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  inscripciones    Inscripcion[]
  credenciales     CredencialQr[]
  asistencias      Asistencia[]

  @@index([apellidos, nombres])
  @@index([estado])
  @@map("estudiantes")
}

model Docente {
  id                     String                @id @default(uuid()) @db.Uuid
  codigoDocente          Int                   @unique @default(autoincrement()) @map("codigo_docente")
  numeroDocumento        String?               @unique @map("numero_documento") @db.VarChar(30)
  nombres                String                @db.VarChar(100)
  apellidos              String                @db.VarChar(120)
  especialidad           String                @db.VarChar(120)
  correo                 String?               @unique @db.VarChar(180)
  telefono               String?               @db.VarChar(30)
  fotografiaUrl          String?               @map("fotografia_url") @db.Text
  estado                 EstadoDocente         @default(ACTIVO)
  creadoEn               DateTime              @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn          DateTime              @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  creadoPor              String?               @map("creado_por") @db.Uuid
  actualizadoPor         String?               @map("actualizado_por") @db.Uuid
  cursos                 DocenteCurso[]
  horariosClase          HorarioClase[]
  asignacionesAcademicas AsignacionAcademica[]

  @@index([apellidos, nombres])
  @@index([estado])
  @@map("docentes")
}

model AsignacionAcademica {
  id               String           @id @default(uuid()) @db.Uuid
  periodoId        String           @map("periodo_id") @db.Uuid
  cursoId          String           @map("curso_id") @db.Uuid
  materiaId        String           @map("materia_id") @db.Uuid
  docenteId        String           @map("docente_id") @db.Uuid
  minutosSemanales Int              @map("minutos_semanales")
  activo           Boolean          @default(true)
  creadoEn         DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime         @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  periodo          PeriodoAcademico @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  curso            Curso            @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  materia          Materia          @relation(fields: [materiaId], references: [id], onDelete: Restrict)
  docente          Docente          @relation(fields: [docenteId], references: [id], onDelete: Restrict)

  @@unique([periodoId, cursoId, materiaId])
  @@index([docenteId, activo])
  @@index([cursoId, activo])
  @@map("asignaciones_academicas")
}

model DocenteCurso {
  docenteId String   @map("docente_id") @db.Uuid
  cursoId   String   @map("curso_id") @db.Uuid
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  docente   Docente  @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  curso     Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@id([docenteId, cursoId])
  @@index([cursoId])
  @@map("docentes_cursos")
}

model HorarioClase {
  id              String                @id @default(uuid()) @db.Uuid
  configuracionId String?               @map("configuracion_id") @db.Uuid
  docenteId       String                @map("docente_id") @db.Uuid
  cursoId         String                @map("curso_id") @db.Uuid
  materiaId       String?               @map("materia_id") @db.Uuid
  aulaId          String?               @map("aula_id") @db.Uuid
  materia         String                @db.VarChar(120)
  diaSemana       Int                   @map("dia_semana")
  horaInicio      DateTime              @map("hora_inicio") @db.Time(0)
  horaFin         DateTime              @map("hora_fin") @db.Time(0)
  activo          Boolean               @default(true)
  creadoEn        DateTime              @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn   DateTime              @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  creadoPor       String?               @map("creado_por") @db.Uuid
  configuracion   ConfiguracionHorario? @relation(fields: [configuracionId], references: [id], onDelete: Restrict)
  docente         Docente               @relation(fields: [docenteId], references: [id], onDelete: Restrict)
  curso           Curso                 @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  materiaCatalogo Materia?              @relation(fields: [materiaId], references: [id], onDelete: Restrict)
  aula            Aula?                 @relation(fields: [aulaId], references: [id], onDelete: Restrict)

  @@index([activo, diaSemana, horaInicio])
  @@index([docenteId, diaSemana, horaInicio])
  @@index([cursoId, diaSemana, horaInicio])
  @@index([configuracionId, activo, diaSemana, horaInicio])
  @@index([aulaId, diaSemana, horaInicio])
  @@map("horarios_clase")
}

model Inscripcion {
  id           String            @id @default(uuid()) @db.Uuid
  estudianteId String            @map("estudiante_id") @db.Uuid
  cursoId      String            @map("curso_id") @db.Uuid
  periodoId    String            @map("periodo_id") @db.Uuid
  estado       EstadoInscripcion @default(ACTIVA)
  creadoEn     DateTime          @default(now()) @map("creado_en") @db.Timestamptz(3)
  estudiante   Estudiante        @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  curso        Curso             @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  periodo      PeriodoAcademico  @relation(fields: [periodoId], references: [id], onDelete: Restrict)

  @@unique([estudianteId, periodoId])
  @@index([cursoId, estado])
  @@index([periodoId, estado])
  @@map("inscripciones")
}

model HorarioIngreso {
  id                String       @id @default(uuid()) @db.Uuid
  cursoId           String       @map("curso_id") @db.Uuid
  jornada           Jornada
  horaLimite        DateTime     @map("hora_limite") @db.Time(0)
  toleranciaMinutos Int          @default(0) @map("tolerancia_minutos")
  zonaHoraria       String       @default("America/La_Paz") @map("zona_horaria") @db.VarChar(80)
  activo            Boolean      @default(true)
  creadoEn          DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime     @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  curso             Curso        @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  asistencias       Asistencia[]

  @@unique([cursoId, jornada])
  @@index([activo])
  @@map("horarios_ingreso")
}

model CredencialQr {
  id           String           @id @default(uuid()) @db.Uuid
  estudianteId String           @map("estudiante_id") @db.Uuid
  tokenHash    String           @unique @map("token_hash") @db.Char(64)
  version      Int              @default(1)
  estado       EstadoCredencial @default(ACTIVA)
  vigenteDesde DateTime         @default(now()) @map("vigente_desde") @db.Timestamptz(3)
  vigenteHasta DateTime?        @map("vigente_hasta") @db.Timestamptz(3)
  creadoEn     DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  estudiante   Estudiante       @relation(fields: [estudianteId], references: [id], onDelete: Restrict)

  @@index([estudianteId, estado])
  @@map("credenciales_qr")
}

model Asistencia {
  id              String           @id @default(uuid()) @db.Uuid
  estudianteId    String           @map("estudiante_id") @db.Uuid
  cursoId         String           @map("curso_id") @db.Uuid
  horarioId       String           @map("horario_id") @db.Uuid
  fechaLocal      DateTime         @map("fecha_local") @db.Date
  fechaHora       DateTime         @default(now()) @map("fecha_hora") @db.Timestamptz(3)
  estado          EstadoAsistencia
  origen          String           @default("QR") @db.VarChar(30)
  registradoPorId String           @map("registrado_por_id") @db.Uuid
  creadoEn        DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  estudiante      Estudiante       @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  curso           Curso            @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  horario         HorarioIngreso   @relation(fields: [horarioId], references: [id], onDelete: Restrict)
  registradoPor   Usuario          @relation("RegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict)

  @@unique([estudianteId, horarioId, fechaLocal])
  @@index([fechaLocal, cursoId, estado])
  @@index([estudianteId, fechaLocal(sort: Desc)])
  @@map("asistencias")
}

model Sesion {
  id          String    @id @default(uuid()) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  dispositivo String?   @db.VarChar(180)
  direccionIp String?   @map("direccion_ip") @db.Inet
  expiraEn    DateTime  @map("expira_en") @db.Timestamptz(3)
  revocadaEn  DateTime? @map("revocada_en") @db.Timestamptz(3)
  creadoEn    DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, revocadaEn])
  @@map("sesiones")
}

model Auditoria {
  id          String   @id @default(uuid()) @db.Uuid
  usuarioId   String?  @map("usuario_id") @db.Uuid
  accion      String   @db.VarChar(80)
  recurso     String   @db.VarChar(80)
  recursoId   String?  @map("recurso_id") @db.VarChar(100)
  metadatos   Json?
  direccionIp String?  @map("direccion_ip") @db.Inet
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, creadoEn(sort: Desc)])
  @@index([recurso, recursoId])
  @@map("auditoria")
}
